<Window
    x:Class="LeaziEnergiaSolar.Wpf.LoginWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:utils="clr-namespace:LeaziEnergiaSolar.Wpf.Utils"
    Title="Leazi Energia Solar"
    Width="1100"
    Height="680"
    WindowStartupLocation="CenterScreen"
    Background="{StaticResource PageBackgroundBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.15*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="{StaticResource LeaziGreenBrush}">
            <StackPanel
                Margin="75"
                VerticalAlignment="Center">

                <Image
                    Width="300"
                    Source="/Assets/Images/logo-leazi.png"
                    Stretch="Uniform" />

                <TextBlock
                    Margin="0,28,0,8"
                    HorizontalAlignment="Center"
                    FontSize="25"
                    FontWeight="SemiBold"
                    Foreground="White"
                    Text="Controle de Vendas e Comissões" />

                <StackPanel
                    Margin="0,18,0,0"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal">

                    <Button
                        Width="46"
                        Height="46"
                        Margin="0,0,12,0"
                        Padding="0"
                        Background="White"
                        BorderBrush="White"
                        Click="Instagram_Click"
                        Cursor="Hand"
                        Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                        ToolTip="Abrir Instagram da Leazi">

                        <materialDesign:PackIcon
                            Width="25"
                            Height="25"
                            Foreground="#C13584"
                            Kind="Instagram" />
                    </Button>

                    <Button
                        Width="46"
                        Height="46"
                        Padding="0"
                        Background="White"
                        BorderBrush="White"
                        Click="WhatsApp_Click"
                        Cursor="Hand"
                        Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                        ToolTip="Abrir WhatsApp da Leazi">

                        <materialDesign:PackIcon
                            Width="26"
                            Height="26"
                            Foreground="#25D366"
                            Kind="Whatsapp" />
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border
            Grid.Column="1"
            Width="380"
            Padding="42"
            VerticalAlignment="Center"
            Background="White"
            CornerRadius="12"
            materialDesign:ElevationAssist.Elevation="Dp4">

            <StackPanel>
                <TextBlock
                    FontSize="28"
                    FontWeight="SemiBold"
                    Text="Acessar sistema" />

                <TextBlock
                    Margin="0,4,0,8"
                    Foreground="#667085"
                    Text="Informe seus dados para continuar" />

                <TextBox
                    Height="48"
                    Margin="0,0,0,18"
                    Padding="14,0,14,0"
                    VerticalContentAlignment="Center"
                    FontSize="14"
                    materialDesign:HintAssist.Hint="Usuário"
                        utils:RequiredFieldHelper.IsRequired="True"
                    materialDesign:HintAssist.IsFloating="True"
                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                    Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}" />

                <Grid
                    Height="48"
                    Margin="0,0,0,12">

                    <PasswordBox
                        x:Name="SenhaPasswordBox"
                        Height="48"
                        Padding="14,0,46,0"
                        VerticalContentAlignment="Center"
                        FontSize="14"
                        materialDesign:HintAssist.Hint="Senha"
                        utils:RequiredFieldHelper.IsRequired="True"
                        materialDesign:HintAssist.IsFloating="True"
                        KeyDown="SenhaCampo_KeyDown"
                        Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                        Visibility="Visible" />

                    <TextBox
                        x:Name="SenhaVisivelTextBox"
                        Height="48"
                        Padding="14,0,46,0"
                        VerticalContentAlignment="Center"
                        FontSize="14"
                        materialDesign:HintAssist.Hint="Senha"
                        materialDesign:HintAssist.IsFloating="True"
                        KeyDown="SenhaCampo_KeyDown"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                        Visibility="Collapsed" />

                    <Button
                        Width="38"
                        Height="38"
                        Margin="0,5,5,5"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Panel.ZIndex="10"
                        Padding="0"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        Click="AlternarSenha_Click"
                        Cursor="Hand"
                        Focusable="False"
                        ToolTip="Mostrar ou ocultar senha">

                        <materialDesign:PackIcon
                            x:Name="IconeSenha"
                            Width="21"
                            Height="21"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="#667085"
                            Kind="Eye" />
                    </Button>
                </Grid>

                <TextBlock
                    Margin="0,0,0,14"
                    Foreground="#D92D20"
                    Text="{Binding MensagemErro}"
                    TextWrapping="Wrap" />

                <Button
                    Height="46"
                    Background="{StaticResource LeaziGreenBrush}"
                    Click="Entrar_Click"
                    Content="ENTRAR"
                    Foreground="White"
                    IsEnabled="{Binding EstaCarregando, Converter={StaticResource InverseBooleanConverter}}"
                    Style="{StaticResource MaterialDesignRaisedButton}" />

                <ProgressBar
                    Height="3"
                    Margin="0,12,0,0"
                    IsIndeterminate="True"
                    Visibility="{Binding EstaCarregando, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>