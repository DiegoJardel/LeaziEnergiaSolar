<Window x:Class="LeaziEnergiaSolar.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Leazi Energia Solar"
        Width="1440"
        Height="860"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBackgroundBrush}">
    <Window.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Margin" Value="0,0,14,0" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="24,14" />
            <Setter Property="FontSize" Value="14" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="235" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="{StaticResource LeaziGreenBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <Image
                        Width="135"
                        Margin="20"
                        Source="/Assets/Images/logo-leazi.png" />

                    <Button
                        Click="Navigate_Click"
                        Content="⌂  Dashboard"
                        Tag="Dashboard" />

                    <Button
                        Click="Navigate_Click"
                        Content="♙  Vendedores"
                        Tag="Vendedores" />

                    <Button
                        Click="Navigate_Click"
                        Content="👤  Clientes"
                        Tag="Clientes" />

                    <Button
                        Click="Navigate_Click"
                        Content="⚙  Equipamentos"
                        Tag="Equipamentos" />

                    <Button
                        Click="Navigate_Click"
                        Content="🏢  Fornecedores"
                        Tag="Fornecedores" />

                    <Button
                        Click="Navigate_Click"
                        Content="$  Lançamentos"
                        Tag="Lancamentos" />

                    <Button
                        Click="Navigate_Click"
                        Content="▣  Controle Mensal"
                        Tag="Mensal" />

                    <Button
                        Click="Navigate_Click"
                        Content="▥  Controle Anual"
                        Tag="Anual" />

                    <Button
                        x:Name="UsuariosButton"
                        Click="Navigate_Click"
                        Content="♟  Usuários"
                        Tag="Usuarios" />
                </StackPanel>

                <StackPanel
                    Margin="24"
                    VerticalAlignment="Bottom">
                    <TextBlock
                        x:Name="UsuarioNomeText"
                        FontWeight="SemiBold"
                        Foreground="White" />

                    <TextBlock
                        x:Name="UsuarioPerfilText"
                        Margin="0,2,0,12"
                        Foreground="#DFFFF0" />

                    <Button
                        Padding="0,8"
                        Click="Backup_Click"
                        Content="Criar backup" />

                    <Button
                        Padding="0,8"
                        Click="Sair_Click"
                        Content="Sair" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Margin="0,0,0,22">
                <TextBlock
                    x:Name="TituloText"
                    FontSize="28"
                    FontWeight="SemiBold"
                    Text="Dashboard" />

                <TextBlock
                    HorizontalAlignment="Right"
                    Foreground="#667085"
                    Text="Leazi Energia Solar" />
            </DockPanel>

            <ContentControl
                x:Name="PageContent"
                Grid.Row="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <UniformGrid
                        Margin="0,0,0,22"
                        Columns="4">
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="TOTAL VENDIDO" />
                                <TextBlock
                                    FontSize="24"
                                    FontWeight="Bold"
                                    Text="R$ 81.600,00" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="TOTAL COMISSÃO" />
                                <TextBlock
                                    FontSize="24"
                                    FontWeight="Bold"
                                    Text="R$ 4.080,00" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="PAGOS" />
                                <TextBlock
                                    FontSize="24"
                                    FontWeight="Bold"
                                    Text="3" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="PENDENTES" />
                                <TextBlock
                                    FontSize="24"
                                    FontWeight="Bold"
                                    Text="1" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Border
                        Grid.Row="1"
                        Padding="24"
                        Background="White"
                        CornerRadius="10">
                        <StackPanel>
                            <TextBlock
                                FontSize="20"
                                FontWeight="SemiBold"
                                Text="Autenticação segura concluída" />

                            <TextBlock
                                Margin="0,10,0,0"
                                Foreground="#667085"
                                Text="A sessão, o perfil, o hash da senha, o login pelo banco e o logout estão configurados."
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
            </ContentControl>
        </Grid>
    </Grid>
</Window>
