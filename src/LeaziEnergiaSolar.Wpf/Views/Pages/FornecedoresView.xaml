<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" xmlns:utils="clr-namespace:LeaziEnergiaSolar.Wpf.Utils" x:Class="LeaziEnergiaSolar.Wpf.Views.Pages.FornecedoresView" Loaded="FornecedoresView_Loaded">
    <Grid Margin="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="18"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Padding="26" Background="White" CornerRadius="12" materialDesign:ElevationAssist.Elevation="Dp2">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock FontSize="21" FontWeight="SemiBold" Text="{Binding TituloFormulario}"/>
                    <TextBlock Margin="0,4,0,20" Foreground="#667085" Text="Preencha os dados cadastrais do fornecedor."/>
                    <TextBlock Margin="0,0,0,14" Foreground="#C62828" FontSize="11" Text="Campos marcados com * são obrigatórios."/>
                    <ComboBox Margin="0,0,0,12" ItemsSource="{Binding TiposPessoa}" SelectedItem="{Binding TipoPessoa}" materialDesign:HintAssist.Hint="Tipo de pessoa" utils:RequiredFieldHelper.IsRequired="True" Style="{StaticResource MaterialDesignOutlinedComboBox}"/>
                    <TextBox Margin="0,0,0,12" MaxLength="150" CharacterCasing="Upper" materialDesign:HintAssist.Hint="Nome ou razão social" utils:RequiredFieldHelper.IsRequired="True" Style="{StaticResource MaterialDesignOutlinedTextBox}" Text="{Binding NomeRazaoSocial,UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBox Margin="0,0,0,12" MaxLength="150" CharacterCasing="Upper" materialDesign:HintAssist.Hint="Nome fantasia" Style="{StaticResource MaterialDesignOutlinedTextBox}" Text="{Binding NomeFantasia,UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBox Margin="0,0,0,12" MaxLength="18" materialDesign:HintAssist.Hint="CPF/CNPJ (opcional)" Style="{StaticResource MaterialDesignOutlinedTextBox}" Text="{Binding CpfCnpj,UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBox Margin="0,0,0,12" MaxLength="15" materialDesign:HintAssist.Hint="Telefone" Style="{StaticResource MaterialDesignOutlinedTextBox}" Text="{Binding Telefone,UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBox Margin="0,0,0,12" MaxLength="150" materialDesign:HintAssist.Hint="E-mail" Style="{StaticResource MaterialDesignOutlinedTextBox}" Text="{Binding Email,UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBox Margin="0,0,0,12" MaxLength="150" CharacterCasing="Upper" materialDesign:HintAssist.Hint="Contato responsável" Style="{StaticResource MaterialDesignOutlinedTextBox}" Text="{Binding ContatoResponsavel,UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBox Height="75" Margin="0,0,0,14" MaxLength="1000" AcceptsReturn="True" CharacterCasing="Upper" materialDesign:HintAssist.Hint="Observação" Style="{StaticResource MaterialDesignOutlinedTextBox}" Text="{Binding Observacao,UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap"/>
                    <ToggleButton Margin="0,0,0,14" Content="Fornecedor ativo" IsChecked="{Binding Ativo}" Style="{StaticResource MaterialDesignSwitchToggleButton}"/>
                    <TextBlock Margin="0,0,0,12" Foreground="{Binding MensagemEhErro,Converter={StaticResource BooleanToMessageBrushConverter}}" Text="{Binding Mensagem}" TextWrapping="Wrap"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Height="42" Background="{StaticResource LeaziGreenBrush}" Command="{Binding SalvarCommand}" Content="SALVAR" Foreground="White" IsEnabled="{Binding EstaCarregando,Converter={StaticResource InverseBooleanConverter}}" Style="{StaticResource MaterialDesignRaisedButton}"/>
                        <Button Grid.Column="2" Height="42" Command="{Binding LimparCommand}" Content="LIMPAR" IsEnabled="{Binding EstaCarregando,Converter={StaticResource InverseBooleanConverter}}" Style="{StaticResource MaterialDesignOutlinedButton}"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>
        <Border Grid.Column="2" Padding="24" Background="White" CornerRadius="12" materialDesign:ElevationAssist.Elevation="Dp2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="110"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Margin="0,0,10,0" materialDesign:HintAssist.Hint="Pesquisar por nome, razão social, CPF/CNPJ ou telefone" Style="{StaticResource MaterialDesignOutlinedTextBox}" Text="{Binding Pesquisa,UpdateSourceTrigger=PropertyChanged}"/>
                    <ComboBox Grid.Column="1" Margin="0,0,10,0" ItemsSource="{Binding FiltrosStatus}" SelectedItem="{Binding FiltroStatus}" Style="{StaticResource MaterialDesignOutlinedComboBox}"/>
                    <Button Grid.Column="2" Height="42" Background="{StaticResource LeaziGreenBrush}" Command="{Binding PesquisarCommand}" Content="PESQUISAR" Foreground="White" Style="{StaticResource MaterialDesignRaisedButton}"/>
                </Grid>
                <DataGrid Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" ItemsSource="{Binding Fornecedores}" RowHeaderWidth="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="65" Binding="{Binding Codigo}" Header="CÓD."/>
                        <DataGridTextColumn Width="1.4*" Binding="{Binding NomeRazaoSocial}" Header="NOME/RAZÃO SOCIAL"/>
                        <DataGridTextColumn Width="1.1*" Binding="{Binding NomeFantasia}" Header="FANTASIA"/>
                        <DataGridTextColumn Width="1*" Binding="{Binding CpfCnpj}" Header="CPF/CNPJ"/>
                        <DataGridTextColumn Width="1*" Binding="{Binding Telefone}" Header="TELEFONE"/>
                        <DataGridTemplateColumn Width="80" Header="STATUS">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock FontWeight="SemiBold" Foreground="{Binding Ativo,Converter={StaticResource BooleanToStatusBrushConverter}}" Text="{Binding Status}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="160" Header="AÇÕES">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Margin="0,0,6,0" Padding="9,4" Command="{Binding DataContext.EditarCommand,RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Content="Editar" Style="{StaticResource MaterialDesignOutlinedButton}"/>
                                        <Button Padding="9,4" Command="{Binding DataContext.AlterarStatusCommand,RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Content="{Binding Ativo,Converter={StaticResource BooleanToStatusActionConverter}}" Style="{StaticResource MaterialDesignOutlinedButton}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Grid.Row="3" Margin="0,12,0,0" Foreground="#667085" Text="{Binding Fornecedores.Count,StringFormat={}Registros encontrados: {0}}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
