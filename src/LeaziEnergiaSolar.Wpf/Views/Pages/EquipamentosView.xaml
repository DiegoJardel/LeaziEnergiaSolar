<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" xmlns:utils="clr-namespace:LeaziEnergiaSolar.Wpf.Utils" x:Class="LeaziEnergiaSolar.Wpf.Views.Pages.EquipamentosView" Loaded="EquipamentosView_Loaded">
    <Grid>
        <TabControl>
            <TabItem Header="EQUIPAMENTOS">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Padding="24" Background="White" CornerRadius="12" materialDesign:ElevationAssist.Elevation="Dp2">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock FontSize="21" FontWeight="SemiBold" Text="{Binding TituloFormulario}"/>
                                <TextBlock Margin="0,4,0,20" Foreground="#667085" Text="Cadastre os dados básicos do equipamento."/>
                                <TextBlock Margin="0,0,0,14" Foreground="#C62828" FontSize="11" Text="Campos marcados com * são obrigatórios."/>
                                <TextBox Margin="0,0,0,12" MaxLength="150" CharacterCasing="Upper" materialDesign:HintAssist.Hint="Descrição" utils:RequiredFieldHelper.IsRequired="True" Style="{StaticResource MaterialDesignOutlinedTextBox}" Text="{Binding Descricao,UpdateSourceTrigger=PropertyChanged}"/>
                                <ComboBox Margin="0,0,0,12" DisplayMemberPath="Descricao" ItemsSource="{Binding CategoriasDisponiveis}" SelectedItem="{Binding CategoriaSelecionada}" materialDesign:HintAssist.Hint="Categoria" utils:RequiredFieldHelper.IsRequired="True" Style="{StaticResource MaterialDesignOutlinedComboBox}"/>
                                <ComboBox Margin="0,0,0,12" DisplayMemberPath="Nome" ItemsSource="{Binding MarcasDisponiveis}" SelectedItem="{Binding MarcaSelecionada}" materialDesign:HintAssist.Hint="Marca (opcional)" Style="{StaticResource MaterialDesignOutlinedComboBox}"/>
                                <TextBox Margin="0,0,0,12" MaxLength="100" CharacterCasing="Upper" materialDesign:HintAssist.Hint="Modelo" Style="{StaticResource MaterialDesignOutlinedTextBox}" Text="{Binding Modelo,UpdateSourceTrigger=PropertyChanged}"/>
                                <ComboBox Margin="0,0,0,12" DisplayMemberPath="Sigla" ItemsSource="{Binding UnidadesDisponiveis}" SelectedItem="{Binding UnidadeSelecionada}" materialDesign:HintAssist.Hint="Unidade de medida" utils:RequiredFieldHelper.IsRequired="True" Style="{StaticResource MaterialDesignOutlinedComboBox}"/>
                                <TextBox Margin="0,0,0,12" MaxLength="15" materialDesign:HintAssist.Hint="Valor de custo" Style="{StaticResource MaterialDesignOutlinedTextBox}" Text="{Binding ValorCusto,UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBox Margin="0,0,0,12" MaxLength="15" materialDesign:HintAssist.Hint="Estoque mínimo" Style="{StaticResource MaterialDesignOutlinedTextBox}" Text="{Binding EstoqueMinimo,UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBox Height="75" Margin="0,0,0,14" MaxLength="1000" AcceptsReturn="True" CharacterCasing="Upper" materialDesign:HintAssist.Hint="Observação" Style="{StaticResource MaterialDesignOutlinedTextBox}" Text="{Binding Observacao,UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap"/>
                                <ToggleButton Margin="0,0,0,14" Content="Equipamento ativo" IsChecked="{Binding Ativo}" Style="{StaticResource MaterialDesignSwitchToggleButton}"/>
                                <TextBlock Margin="0,0,0,12" Foreground="{Binding MensagemEhErro,Converter={StaticResource BooleanToMessageBrushConverter}}" Text="{Binding Mensagem}" TextWrapping="Wrap"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Height="42" Background="{StaticResource LeaziGreenBrush}" Command="{Binding SalvarCommand}" Content="SALVAR" Foreground="White" IsEnabled="{Binding EstaCarregando,Converter={StaticResource InverseBooleanConverter}}" Style="{StaticResource MaterialDesignRaisedButton}"/>
                                    <Button Grid.Column="2" Height="42" Command="{Binding LimparCommand}" Content="LIMPAR" IsEnabled="{Binding EstaCarregando,Converter={StaticResource InverseBooleanConverter}}" Style="{StaticResource MaterialDesignOutlinedButton}"/>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                    <Border Grid.Column="2" Padding="22" Background="White" CornerRadius="12" materialDesign:ElevationAssist.Elevation="Dp2">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="14"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Margin="0,0,10,0" materialDesign:HintAssist.Hint="Pesquisar por código, descrição, marca ou modelo" Style="{StaticResource MaterialDesignOutlinedTextBox}" Text="{Binding Pesquisa,UpdateSourceTrigger=PropertyChanged}"/>
                                <ComboBox Grid.Column="1" Margin="0,0,10,0" DisplayMemberPath="Descricao" ItemsSource="{Binding Categorias}" SelectedItem="{Binding FiltroCategoria}" materialDesign:HintAssist.Hint="Categoria" Style="{StaticResource MaterialDesignOutlinedComboBox}"/>
                                <ComboBox Grid.Column="2" Margin="0,0,10,0" DisplayMemberPath="Nome" ItemsSource="{Binding Marcas}" SelectedItem="{Binding FiltroMarca}" materialDesign:HintAssist.Hint="Marca" Style="{StaticResource MaterialDesignOutlinedComboBox}"/>
                                <Button Grid.Column="3" Height="42" Background="{StaticResource LeaziGreenBrush}" Command="{Binding PesquisarCommand}" Content="PESQUISAR" Foreground="White" Style="{StaticResource MaterialDesignRaisedButton}"/>
                            </Grid>
                            <ComboBox Grid.Row="1" Width="130" HorizontalAlignment="Left" ItemsSource="{Binding FiltrosStatus}" SelectedItem="{Binding FiltroStatus}" Style="{StaticResource MaterialDesignOutlinedComboBox}"/>
                            <DataGrid Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" ItemsSource="{Binding Equipamentos}" RowHeaderWidth="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Width="70" Binding="{Binding Codigo}" Header="CÓD."/>
                                    <DataGridTextColumn Width="1.6*" Binding="{Binding Descricao}" Header="DESCRIÇÃO"/>
                                    <DataGridTextColumn Width="1.1*" Binding="{Binding Categoria}" Header="CATEGORIA"/>
                                    <DataGridTextColumn Width="1*" Binding="{Binding Marca}" Header="MARCA"/>
                                    <DataGridTextColumn Width="1*" Binding="{Binding Modelo}" Header="MODELO"/>
                                    <DataGridTextColumn Width="100" Binding="{Binding UnidadeMedida}" Header="UN."/>
                                    <DataGridTemplateColumn Width="80" Header="STATUS">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock FontWeight="SemiBold" Foreground="{Binding Ativo,Converter={StaticResource BooleanToStatusBrushConverter}}" Text="{Binding Status}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Width="160" Header="AÇÕES">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Margin="0,0,6,0" Padding="9,4" Command="{Binding DataContext.EditarCommand,RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Content="Editar" Style="{StaticResource MaterialDesignOutlinedButton}"/>
                                                    <Button Padding="9,4" Command="{Binding DataContext.AlterarStatusCommand,RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Content="{Binding Ativo,Converter={StaticResource BooleanToStatusActionConverter}}" Style="{StaticResource MaterialDesignOutlinedButton}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Grid.Row="3" Margin="0,12,0,0" Foreground="#667085" Text="{Binding Equipamentos.Count,StringFormat={}Registros encontrados: {0}}"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="CATEGORIAS">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="330"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Padding="22" Background="White" CornerRadius="12">
                        <StackPanel>
                            <TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding TituloCategoria}"/>
                            <TextBlock Margin="0,4,0,20" Foreground="#667085" Text="Cadastro auxiliar de categorias."/>
                            <TextBox Margin="0,0,0,12" MaxLength="100" CharacterCasing="Upper" materialDesign:HintAssist.Hint="Descrição" utils:RequiredFieldHelper.IsRequired="True" Style="{StaticResource MaterialDesignOutlinedTextBox}" Text="{Binding CategoriaDescricao,UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBox Height="70" Margin="0,0,0,12" MaxLength="500" AcceptsReturn="True" CharacterCasing="Upper" materialDesign:HintAssist.Hint="Observação" Style="{StaticResource MaterialDesignOutlinedTextBox}" Text="{Binding CategoriaObservacao,UpdateSourceTrigger=PropertyChanged}"/>
                            <ToggleButton Margin="0,0,0,14" Content="Categoria ativa" IsChecked="{Binding CategoriaAtivo}" Style="{StaticResource MaterialDesignSwitchToggleButton}"/>
                            <Button Height="42" Background="{StaticResource LeaziGreenBrush}" Command="{Binding SalvarCategoriaCommand}" Content="SALVAR" Foreground="White" Style="{StaticResource MaterialDesignRaisedButton}"/>
                            <Button Margin="0,10,0,0" Height="42" Command="{Binding LimparCategoriaCommand}" Content="LIMPAR" Style="{StaticResource MaterialDesignOutlinedButton}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Padding="22" Background="White" CornerRadius="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBox Margin="0,0,0,12" materialDesign:HintAssist.Hint="Pesquisar categoria" Style="{StaticResource MaterialDesignOutlinedTextBox}" Text="{Binding PesquisaCategoria,UpdateSourceTrigger=PropertyChanged}"/>
                            <DataGrid Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" ItemsSource="{Binding Categorias}" RowHeaderWidth="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Width="*" Binding="{Binding Descricao}" Header="DESCRIÇÃO"/>
                                    <DataGridTextColumn Width="120" Binding="{Binding Status}" Header="STATUS"/>
                                    <DataGridTemplateColumn Width="180" Header="AÇÕES">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Margin="0,0,6,0" Padding="8,4" Command="{Binding DataContext.EditarCategoriaCommand,RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Content="Editar" Style="{StaticResource MaterialDesignOutlinedButton}"/>
                                                    <Button Padding="8,4" Command="{Binding DataContext.AlterarStatusCategoriaCommand,RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Content="{Binding Ativo,Converter={StaticResource BooleanToStatusActionConverter}}" Style="{StaticResource MaterialDesignOutlinedButton}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="MARCAS">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="330"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Padding="22" Background="White" CornerRadius="12">
                        <StackPanel>
                            <TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding TituloMarca}"/>
                            <TextBlock Margin="0,4,0,20" Foreground="#667085" Text="Cadastro auxiliar de marcas."/>
                            <TextBox Margin="0,0,0,12" MaxLength="100" CharacterCasing="Upper" materialDesign:HintAssist.Hint="Nome" utils:RequiredFieldHelper.IsRequired="True" Style="{StaticResource MaterialDesignOutlinedTextBox}" Text="{Binding MarcaNome,UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBox Height="70" Margin="0,0,0,12" MaxLength="500" AcceptsReturn="True" CharacterCasing="Upper" materialDesign:HintAssist.Hint="Observação" Style="{StaticResource MaterialDesignOutlinedTextBox}" Text="{Binding MarcaObservacao,UpdateSourceTrigger=PropertyChanged}"/>
                            <ToggleButton Margin="0,0,0,14" Content="Marca ativa" IsChecked="{Binding MarcaAtivo}" Style="{StaticResource MaterialDesignSwitchToggleButton}"/>
                            <Button Height="42" Background="{StaticResource LeaziGreenBrush}" Command="{Binding SalvarMarcaCommand}" Content="SALVAR" Foreground="White" Style="{StaticResource MaterialDesignRaisedButton}"/>
                            <Button Margin="0,10,0,0" Height="42" Command="{Binding LimparMarcaCommand}" Content="LIMPAR" Style="{StaticResource MaterialDesignOutlinedButton}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Padding="22" Background="White" CornerRadius="12">
                        <DataGrid AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" ItemsSource="{Binding Marcas}" RowHeaderWidth="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="*" Binding="{Binding Nome}" Header="NOME"/>
                                <DataGridTextColumn Width="120" Binding="{Binding Status}" Header="STATUS"/>
                                <DataGridTemplateColumn Width="180" Header="AÇÕES">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Margin="0,0,6,0" Padding="8,4" Command="{Binding DataContext.EditarMarcaCommand,RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Content="Editar" Style="{StaticResource MaterialDesignOutlinedButton}"/>
                                                <Button Padding="8,4" Command="{Binding DataContext.AlterarStatusMarcaCommand,RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Content="{Binding Ativo,Converter={StaticResource BooleanToStatusActionConverter}}" Style="{StaticResource MaterialDesignOutlinedButton}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="UNIDADES">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="330"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Padding="22" Background="White" CornerRadius="12">
                        <StackPanel>
                            <TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding TituloUnidade}"/>
                            <TextBlock Margin="0,4,0,20" Foreground="#667085" Text="Cadastro auxiliar de unidades de medida."/>
                            <TextBox Margin="0,0,0,12" MaxLength="10" CharacterCasing="Upper" materialDesign:HintAssist.Hint="Sigla" utils:RequiredFieldHelper.IsRequired="True" Style="{StaticResource MaterialDesignOutlinedTextBox}" Text="{Binding UnidadeSigla,UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBox Margin="0,0,0,12" MaxLength="100" CharacterCasing="Upper" materialDesign:HintAssist.Hint="Descrição" utils:RequiredFieldHelper.IsRequired="True" Style="{StaticResource MaterialDesignOutlinedTextBox}" Text="{Binding UnidadeDescricao,UpdateSourceTrigger=PropertyChanged}"/>
                            <CheckBox Margin="0,0,0,14" Content="Permite quantidade decimal" IsChecked="{Binding UnidadePermiteQuantidadeDecimal}"/>
                            <ToggleButton Margin="0,0,0,14" Content="Unidade ativa" IsChecked="{Binding UnidadeAtivo}" Style="{StaticResource MaterialDesignSwitchToggleButton}"/>
                            <Button Height="42" Background="{StaticResource LeaziGreenBrush}" Command="{Binding SalvarUnidadeCommand}" Content="SALVAR" Foreground="White" Style="{StaticResource MaterialDesignRaisedButton}"/>
                            <Button Margin="0,10,0,0" Height="42" Command="{Binding LimparUnidadeCommand}" Content="LIMPAR" Style="{StaticResource MaterialDesignOutlinedButton}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Padding="22" Background="White" CornerRadius="12">
                        <DataGrid AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" ItemsSource="{Binding Unidades}" RowHeaderWidth="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="90" Binding="{Binding Sigla}" Header="SIGLA"/>
                                <DataGridTextColumn Width="*" Binding="{Binding Descricao}" Header="DESCRIÇÃO"/>
                                <DataGridCheckBoxColumn Width="110" Binding="{Binding PermiteQuantidadeDecimal}" Header="DECIMAL"/>
                                <DataGridTextColumn Width="100" Binding="{Binding Status}" Header="STATUS"/>
                                <DataGridTemplateColumn Width="180" Header="AÇÕES">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Margin="0,0,6,0" Padding="8,4" Command="{Binding DataContext.EditarUnidadeCommand,RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Content="Editar" Style="{StaticResource MaterialDesignOutlinedButton}"/>
                                                <Button Padding="8,4" Command="{Binding DataContext.AlterarStatusUnidadeCommand,RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Content="{Binding Ativo,Converter={StaticResource BooleanToStatusActionConverter}}" Style="{StaticResource MaterialDesignOutlinedButton}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
