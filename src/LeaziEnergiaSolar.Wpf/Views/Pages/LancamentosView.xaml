<UserControl x:Class="LeaziEnergiaSolar.Wpf.Views.Pages.LancamentosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:utils="clr-namespace:LeaziEnergiaSolar.Wpf.Utils"
             d:DesignHeight="740"
             d:DesignWidth="1180"
             Loaded="LancamentosView_Loaded"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Padding="22"
            Background="White"
            CornerRadius="12"
            materialDesign:ElevationAssist.Elevation="Dp2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel>
                    <TextBlock
                        FontSize="21"
                        FontWeight="SemiBold"
                        Text="{Binding TituloFormulario}" />

                    <Button
                        Width="110"
                        Height="36"
                        HorizontalAlignment="Right"
                        Command="{Binding NovoCommand}"
                        Content="NOVO"
                        Style="{StaticResource MaterialDesignOutlinedButton}" />
                </DockPanel>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.05*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="1.6*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="1.35*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="0.9*" />
                    </Grid.ColumnDefinitions>

                    <DatePicker
                        Grid.Column="0"
                        materialDesign:HintAssist.Hint="Data da venda"
                        utils:RequiredFieldHelper.IsRequired="True"
                        SelectedDate="{Binding DataVenda}"
                        Style="{StaticResource MaterialDesignOutlinedDatePicker}" />

                    <ComboBox
                        Grid.Column="2"
                        DisplayMemberPath="NomeRazaoSocial"
                        ItemsSource="{Binding Clientes}"
                        materialDesign:HintAssist.Hint="Cliente cadastrado"
                        utils:RequiredFieldHelper.IsRequired="True"
                        SelectedItem="{Binding ClienteSelecionado, Mode=TwoWay}"
                        Style="{StaticResource MaterialDesignOutlinedComboBox}" />

                    <TextBox
                        Grid.Column="4"
                        IsReadOnly="True"
                        materialDesign:HintAssist.Hint="CPF/CNPJ do cliente"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                        Text="{Binding CpfCnpjCliente}" />

                    <ComboBox
                        Grid.Column="6"
                        DisplayMemberPath="Nome"
                        ItemsSource="{Binding Vendedores}"
                        materialDesign:HintAssist.Hint="Vendedor"
                        utils:RequiredFieldHelper.IsRequired="True"
                        SelectedItem="{Binding VendedorSelecionado}"
                        Style="{StaticResource MaterialDesignOutlinedComboBox}" />

                    <ComboBox
                        Grid.Column="8"
                        ItemsSource="{Binding StatusDisponiveis}"
                        materialDesign:HintAssist.Hint="Status"
                        utils:RequiredFieldHelper.IsRequired="True"
                        SelectedItem="{Binding StatusSelecionado}"
                        Style="{StaticResource MaterialDesignOutlinedComboBox}" />
                </Grid>

                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.05*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="0.8*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="1.05*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="2.2*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox
                        Grid.Column="0"
                        materialDesign:HintAssist.Hint="Valor da venda"
                        utils:RequiredFieldHelper.IsRequired="True"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                        Text="{Binding ValorVenda, UpdateSourceTrigger=PropertyChanged}"
                        utils:CurrencyInputBehavior.IsEnabled="True" />

                    <TextBox
                        Grid.Column="2"
                        materialDesign:HintAssist.Hint="Comissão (%)"
                        utils:RequiredFieldHelper.IsRequired="True"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                        Text="{Binding PercentualComissao, UpdateSourceTrigger=PropertyChanged}"
                        utils:InputBehavior.Type="Decimal" />

                    <TextBox
                        Grid.Column="4"
                        IsReadOnly="True"
                        materialDesign:HintAssist.Hint="Comissão calculada"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                        Text="{Binding ValorComissao}" />

                    <TextBox
                        Grid.Column="6"
                        MaxLength="500"
                        materialDesign:HintAssist.Hint="Observação"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                        Text="{Binding Observacao, UpdateSourceTrigger=PropertyChanged}" />

                    <StackPanel Grid.Column="8" Orientation="Horizontal">
                        <Button
                            Width="92"
                            Height="42"
                            Margin="0,0,8,0"
                            Background="{StaticResource LeaziGreenBrush}"
                            Command="{Binding SalvarCommand}"
                            Content="SALVAR"
                            Foreground="White"
                            IsEnabled="{Binding EstaCarregando, Converter={StaticResource InverseBooleanConverter}}"
                            Style="{StaticResource MaterialDesignRaisedButton}" />

                        <Button
                            Width="86"
                            Height="42"
                            Command="{Binding LimparCommand}"
                            Content="LIMPAR"
                            Style="{StaticResource MaterialDesignOutlinedButton}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Border
            Grid.Row="2"
            Padding="22"
            Background="White"
            CornerRadius="12"
            materialDesign:ElevationAssist.Elevation="Dp2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    FontSize="18"
                    FontWeight="SemiBold"
                    Text="Lançamentos cadastrados" />

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.7*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="1.05*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="1.05*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="1.35*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="1.05*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox
                        Grid.Column="0"
                        materialDesign:HintAssist.Hint="Cliente, vendedor ou documento"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                        Text="{Binding Pesquisa, UpdateSourceTrigger=PropertyChanged}" />

                    <DatePicker
                        Grid.Column="2"
                        materialDesign:HintAssist.Hint="Data inicial"
                        SelectedDate="{Binding FiltroDataInicial}"
                        Style="{StaticResource MaterialDesignOutlinedDatePicker}" />

                    <DatePicker
                        Grid.Column="4"
                        materialDesign:HintAssist.Hint="Data final"
                        SelectedDate="{Binding FiltroDataFinal}"
                        Style="{StaticResource MaterialDesignOutlinedDatePicker}" />

                    <ComboBox
                        Grid.Column="6"
                        DisplayMemberPath="Nome"
                        ItemsSource="{Binding Vendedores}"
                        materialDesign:HintAssist.Hint="Vendedor"
                        SelectedItem="{Binding FiltroVendedor}"
                        Style="{StaticResource MaterialDesignOutlinedComboBox}" />

                    <ComboBox
                        Grid.Column="8"
                        ItemsSource="{Binding StatusDisponiveis}"
                        materialDesign:HintAssist.Hint="Status"
                        SelectedItem="{Binding FiltroStatus}"
                        Style="{StaticResource MaterialDesignOutlinedComboBox}" />

                    <StackPanel Grid.Column="10" Orientation="Horizontal">
                        <Button
                            Width="90"
                            Height="42"
                            Margin="0,0,8,0"
                            Background="{StaticResource LeaziGreenBrush}"
                            Command="{Binding FiltrarCommand}"
                            Content="FILTRAR"
                            Foreground="White"
                            Style="{StaticResource MaterialDesignRaisedButton}" />

                        <Button
                            Width="84"
                            Height="42"
                            Command="{Binding LimparFiltrosCommand}"
                            Content="LIMPAR"
                            Style="{StaticResource MaterialDesignOutlinedButton}" />
                    </StackPanel>
                </Grid>

                <DataGrid
                    Grid.Row="4"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    HeadersVisibility="Column"
                    IsReadOnly="True"
                    ItemsSource="{Binding Lancamentos}"
                    RowHeaderWidth="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Width="0.8*"
                            Binding="{Binding DataVenda, StringFormat={}{0:dd/MM/yyyy}}"
                            Header="DATA" />

                        <DataGridTextColumn
                            Width="1.4*"
                            Binding="{Binding Cliente}"
                            Header="CLIENTE" />

                        <DataGridTextColumn
                            Width="1.15*"
                            Binding="{Binding VendedorNome}"
                            Header="VENDEDOR" />

                        <DataGridTextColumn
                            Width="0.9*"
                            Binding="{Binding ValorVenda, StringFormat={}{0:C2}}"
                            Header="VENDA" />

                        <DataGridTextColumn
                            Width="0.65*"
                            Binding="{Binding PercentualComissao, StringFormat={}{0:N2}%}"
                            Header="%" />

                        <DataGridTextColumn
                            Width="0.9*"
                            Binding="{Binding ValorComissao, StringFormat={}{0:C2}}"
                            Header="COMISSÃO" />

                        <DataGridTemplateColumn
                            Width="0.75*"
                            Header="STATUS">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Foreground="{Binding Status, Converter={StaticResource StatusLancamentoToBrushConverter}}"
                                        Text="{Binding StatusDescricao}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn
                            Width="1.75*"
                            Header="AÇÕES">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button
                                            Margin="0,0,5,0"
                                            Padding="8,4"
                                            Command="{Binding DataContext.EditarCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Content="Editar"
                                            Style="{StaticResource MaterialDesignOutlinedButton}" />

                                        <Button
                                            Margin="0,0,5,0"
                                            Padding="8,4"
                                            Command="{Binding DataContext.AlternarStatusCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Content="{Binding Status, Converter={StaticResource StatusLancamentoToActionConverter}}"
                                            Style="{StaticResource MaterialDesignOutlinedButton}" />

                                        <Button
                                            Padding="8,4"
                                            Click="Excluir_Click"
                                            Content="Excluir"
                                            Foreground="#D92D20"
                                            Style="{StaticResource MaterialDesignOutlinedButton}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <DockPanel Grid.Row="5" Margin="0,12,0,0">
                    <ProgressBar
                        Width="120"
                        Height="3"
                        DockPanel.Dock="Right"
                        IsIndeterminate="True"
                        Visibility="{Binding EstaCarregando, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <TextBlock
                        Margin="0,0,18,0"
                        Foreground="{Binding MensagemEhErro, Converter={StaticResource BooleanToMessageBrushConverter}}"
                        Text="{Binding Mensagem}"
                        TextWrapping="Wrap" />

                    <TextBlock
                        DockPanel.Dock="Right"
                        Foreground="#667085"
                        Text="{Binding Lancamentos.Count, StringFormat={}Registros: {0}}" />
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
