<UserControl x:Class="LeaziEnergiaSolar.Wpf.Views.Pages.ClientesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:utils="clr-namespace:LeaziEnergiaSolar.Wpf.Utils"
             d:DesignHeight="720"
             d:DesignWidth="1180"
             Loaded="ClientesView_Loaded"
             mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="440" />
            <ColumnDefinition Width="22" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Padding="24"
                Background="White"
                CornerRadius="12"
                materialDesign:ElevationAssist.Elevation="Dp2">

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock FontSize="21"
                               FontWeight="SemiBold"
                               Text="{Binding TituloFormulario}" />

                    <TextBlock Margin="0,4,0,20"
                               Foreground="#667085"
                               Text="Cadastro básico, contato e endereço do cliente." />

                    <TextBlock Margin="0,0,0,14" Foreground="#C62828" FontSize="11" Text="Campos marcados com * são obrigatórios." />

                    <TextBlock Margin="0,0,0,6"
                               FontWeight="SemiBold"
                               Text="DADOS BÁSICOS" />

                    <ComboBox Margin="0,0,0,12"
                              ItemsSource="{Binding TiposPessoa}"
                              SelectedItem="{Binding TipoPessoa, Mode=TwoWay}"
                              materialDesign:HintAssist.Hint="Tipo de pessoa"
                              utils:RequiredFieldHelper.IsRequired="True"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}" />

                    <TextBox Margin="0,0,0,12"
                             MaxLength="150"
                             CharacterCasing="Upper"
                             materialDesign:HintAssist.Hint="Nome ou razão social"
                             utils:RequiredFieldHelper.IsRequired="True"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Text="{Binding NomeRazaoSocial, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBox Margin="0,0,0,12"
                             MaxLength="150"
                             CharacterCasing="Upper"
                             materialDesign:HintAssist.Hint="Nome fantasia"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Text="{Binding NomeFantasia, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBox Margin="0,0,0,12"
                             MaxLength="18"
                             materialDesign:HintAssist.Hint="CPF ou CNPJ"
                             utils:RequiredFieldHelper.IsRequired="True"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Text="{Binding CpfCnpj, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBox Margin="0,0,0,12"
                             MaxLength="20"
                             CharacterCasing="Upper"
                             materialDesign:HintAssist.Hint="RG ou inscrição estadual"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Text="{Binding RgInscricaoEstadual, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Margin="0,0,0,6"
                               FontWeight="SemiBold"
                               Text="CONTATO" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 MaxLength="15"
                                 materialDesign:HintAssist.Hint="Telefone"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Text="{Binding Telefone, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBox Grid.Column="2"
                                 MaxLength="15"
                                 materialDesign:HintAssist.Hint="WhatsApp"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Text="{Binding WhatsApp, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>

                    <TextBox Margin="0,0,0,18"
                             MaxLength="150"
                             CharacterCasing="Lower"
                             materialDesign:HintAssist.Hint="E-mail"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Margin="0,0,0,6"
                               FontWeight="SemiBold"
                               Text="ENDEREÇO" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="86" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 MaxLength="9"
                                 materialDesign:HintAssist.Hint="CEP"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Text="{Binding Cep, UpdateSourceTrigger=PropertyChanged}" />

                        <Button Grid.Column="2"
                                Height="42"
                                Command="{Binding ConsultarCepCommand}"
                                Content="BUSCAR"
                                IsEnabled="{Binding EstaCarregando, Converter={StaticResource InverseBooleanConverter}}"
                                Style="{StaticResource MaterialDesignOutlinedButton}" />

                        <TextBox Grid.Column="4"
                                 MaxLength="150"
                                 CharacterCasing="Upper"
                                 materialDesign:HintAssist.Hint="Logradouro"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Text="{Binding Logradouro, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 MaxLength="20"
                                 CharacterCasing="Upper"
                                 materialDesign:HintAssist.Hint="Número"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Text="{Binding Numero, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBox Grid.Column="2"
                                 MaxLength="100"
                                 CharacterCasing="Upper"
                                 materialDesign:HintAssist.Hint="Complemento"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Text="{Binding Complemento, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>

                    <TextBox Margin="0,0,0,12"
                             MaxLength="100"
                             CharacterCasing="Upper"
                             materialDesign:HintAssist.Hint="Bairro"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Text="{Binding Bairro, UpdateSourceTrigger=PropertyChanged}" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="190" />
                        </Grid.ColumnDefinitions>

                        <ComboBox Grid.Column="0"
                                  DisplayMemberPath="Nome"
                                  IsEditable="False"
                                  ItemsSource="{Binding Municipios}"
                                  MaxDropDownHeight="300"
                                  materialDesign:HintAssist.Hint="Município"
                                  utils:RequiredFieldHelper.IsRequired="True"
                                  SelectedItem="{Binding MunicipioSelecionado, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}" />

                        <ComboBox Grid.Column="2"
                                  DisplayMemberPath="Nome"
                                  IsEditable="False"
                                  ItemsSource="{Binding Estados}"
                                  MaxDropDownHeight="300"
                                  materialDesign:HintAssist.Hint="Estado"
                                  utils:RequiredFieldHelper.IsRequired="True"
                                  SelectedItem="{Binding EstadoSelecionado, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}" />
                    </Grid>

                    <TextBox Margin="0,0,0,16"
                             MaxLength="200"
                             CharacterCasing="Upper"
                             materialDesign:HintAssist.Hint="Ponto de referência"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Text="{Binding PontoReferencia, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBox Height="80"
                             Margin="0,0,0,16"
                             AcceptsReturn="True"
                             CharacterCasing="Upper"
                             MaxLength="1000"
                             materialDesign:HintAssist.Hint="Observação"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Text="{Binding Observacao, UpdateSourceTrigger=PropertyChanged}"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" />

                    <ToggleButton Margin="0,0,0,16"
                                  Content="Cliente ativo"
                                  IsChecked="{Binding Ativo}"
                                  Style="{StaticResource MaterialDesignSwitchToggleButton}" />

                    <TextBlock Margin="0,0,0,14"
                               Foreground="{Binding MensagemEhErro, Converter={StaticResource BooleanToMessageBrushConverter}}"
                               Text="{Binding Mensagem}"
                               TextWrapping="Wrap" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Height="42"
                                Background="{StaticResource LeaziGreenBrush}"
                                Command="{Binding SalvarCommand}"
                                Content="SALVAR"
                                Foreground="White"
                                IsEnabled="{Binding EstaCarregando, Converter={StaticResource InverseBooleanConverter}}"
                                Style="{StaticResource MaterialDesignRaisedButton}" />

                        <Button Grid.Column="2"
                                Height="42"
                                Command="{Binding LimparCommand}"
                                Content="LIMPAR"
                                IsEnabled="{Binding EstaCarregando, Converter={StaticResource InverseBooleanConverter}}"
                                Style="{StaticResource MaterialDesignOutlinedButton}" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Column="2"
                Padding="24"
                Background="White"
                CornerRadius="12"
                materialDesign:ElevationAssist.Elevation="Dp2">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             materialDesign:HintAssist.Hint="Nome, CPF/CNPJ, telefone ou cidade"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Text="{Binding Pesquisa, UpdateSourceTrigger=PropertyChanged}" />

                    <ComboBox Grid.Column="2"
                              ItemsSource="{Binding FiltrosStatus}"
                              SelectedItem="{Binding FiltroStatus}"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}" />

                    <Button Grid.Column="4"
                            MinWidth="110"
                            Height="42"
                            Background="{StaticResource LeaziGreenBrush}"
                            Command="{Binding PesquisarCommand}"
                            Content="PESQUISAR"
                            Foreground="White"
                            IsEnabled="{Binding EstaCarregando, Converter={StaticResource InverseBooleanConverter}}"
                            Style="{StaticResource MaterialDesignRaisedButton}" />
                </Grid>

                <DataGrid Grid.Row="2"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          IsReadOnly="True"
                          ItemsSource="{Binding Clientes}"
                          RowHeaderWidth="0"
                          SelectedItem="{Binding ClienteSelecionado}"
                          SelectionMode="Single">

                    <DataGrid.Columns>
                        <DataGridTextColumn Width="1.7*"
                                            Binding="{Binding NomeRazaoSocial}"
                                            Header="NOME / RAZÃO SOCIAL" />

                        <DataGridTextColumn Width="1.15*"
                                            Binding="{Binding CpfCnpj}"
                                            Header="CPF/CNPJ" />

                        <DataGridTextColumn Width="1.15*"
                                            Binding="{Binding Telefone}"
                                            Header="TELEFONE" />

                        <DataGridTextColumn Width="1.25*"
                                            Binding="{Binding CidadeUf}"
                                            Header="CIDADE / UF" />

                        <DataGridTemplateColumn Width="0.8*"
                                                Header="STATUS">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock FontWeight="SemiBold"
                                               Foreground="{Binding Ativo, Converter={StaticResource BooleanToStatusBrushConverter}}"
                                               Text="{Binding Status}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Width="1.65*"
                                                Header="AÇÕES">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Margin="0,0,6,0"
                                                Padding="10,5"
                                                Command="{Binding DataContext.EditarCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Content="Editar"
                                                IsEnabled="{Binding DataContext.EstaCarregando, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource InverseBooleanConverter}}"
                                                Style="{StaticResource MaterialDesignOutlinedButton}" />

                                        <Button Padding="10,5"
                                                Margin="0,0,6,0"
                                                Command="{Binding DataContext.AlterarStatusCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Content="Ativar/Inativar"
                                                IsEnabled="{Binding DataContext.EstaCarregando, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource InverseBooleanConverter}}"
                                                Style="{StaticResource MaterialDesignOutlinedButton}" />

                                        <Button Padding="10,5"
                                                Click="Excluir_Click"
                                                Content="Excluir"
                                                Foreground="#D92D20"
                                                IsEnabled="{Binding DataContext.EstaCarregando, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource InverseBooleanConverter}}"
                                                Style="{StaticResource MaterialDesignOutlinedButton}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <DockPanel Grid.Row="3"
                           Margin="0,14,0,0">

                    <ProgressBar Width="120"
                                 Height="3"
                                 DockPanel.Dock="Right"
                                 IsIndeterminate="True"
                                 Visibility="{Binding EstaCarregando, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <TextBlock Foreground="#667085"
                               Text="{Binding Clientes.Count, StringFormat={}Registros encontrados: {0}}" />
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>