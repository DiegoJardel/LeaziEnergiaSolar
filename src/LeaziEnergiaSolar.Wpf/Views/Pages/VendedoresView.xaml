<UserControl x:Class="LeaziEnergiaSolar.Wpf.Views.Pages.VendedoresView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:utils="clr-namespace:LeaziEnergiaSolar.Wpf.Utils"
             d:DesignHeight="720"
             d:DesignWidth="1180"
             Loaded="VendedoresView_Loaded"
             mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="22" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border
            Grid.Column="0"
            Padding="26"
            Background="White"
            CornerRadius="12"
            materialDesign:ElevationAssist.Elevation="Dp2">

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock
                        FontSize="21"
                        FontWeight="SemiBold"
                        Text="{Binding TituloFormulario}" />

                    <TextBlock
                        Margin="0,4,0,24"
                        Foreground="#667085"
                        Text="Preencha os dados comerciais do vendedor." />

                    <TextBox
                        Margin="0,0,0,16"
                        MaxLength="100"
                        CharacterCasing="Upper"
                        materialDesign:HintAssist.Hint="Nome completo"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                        Text="{Binding Nome, UpdateSourceTrigger=PropertyChanged}"
                        utils:InputBehavior.Type="SomenteLetras" />

                    <TextBox
                        Margin="0,0,0,16"
                        MaxLength="18"
                        materialDesign:HintAssist.Hint="CPF ou CNPJ"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                        Text="{Binding CpfCnpj, UpdateSourceTrigger=PropertyChanged}"
                        utils:InputBehavior.Type="Livre" />

                    <TextBox
                        Margin="0,0,0,16"
                        MaxLength="15"
                        materialDesign:HintAssist.Hint="Telefone com DDD"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                        Text="{Binding Telefone, UpdateSourceTrigger=PropertyChanged}"
                        utils:InputBehavior.Type="Livre" />

                    <TextBox
                        Margin="0,0,0,16"
                        MaxLength="150"
                        CharacterCasing="Lower"
                        materialDesign:HintAssist.Hint="E-mail"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                        Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBox
                        Margin="0,0,0,14"
                        MaxLength="6"
                        materialDesign:HintAssist.Hint="Comissão (%)"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                        Text="{Binding PercentualComissao, UpdateSourceTrigger=PropertyChanged}"
                        utils:InputBehavior.Type="Decimal" />

                    <ToggleButton
                        Margin="0,0,0,18"
                        Content="Vendedor ativo"
                        IsChecked="{Binding Ativo}"
                        Style="{StaticResource MaterialDesignSwitchToggleButton}" />

                    <TextBlock
                        Margin="0,0,0,14"
                        Foreground="{Binding MensagemEhErro, Converter={StaticResource BooleanToMessageBrushConverter}}"
                        Text="{Binding Mensagem}"
                        TextWrapping="Wrap" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button
                            Grid.Column="0"
                            Height="42"
                            Background="{StaticResource LeaziGreenBrush}"
                            Command="{Binding SalvarCommand}"
                            Content="SALVAR"
                            Foreground="White"
                            IsEnabled="{Binding EstaCarregando, Converter={StaticResource InverseBooleanConverter}}"
                            Style="{StaticResource MaterialDesignRaisedButton}" />

                        <Button
                            Grid.Column="2"
                            Height="42"
                            Command="{Binding LimparCommand}"
                            Content="LIMPAR"
                            IsEnabled="{Binding EstaCarregando, Converter={StaticResource InverseBooleanConverter}}"
                            Style="{StaticResource MaterialDesignOutlinedButton}" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border
            Grid.Column="2"
            Padding="24"
            Background="White"
            CornerRadius="12"
            materialDesign:ElevationAssist.Elevation="Dp2">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox
                        Grid.Column="0"
                        MinWidth="300"
                        materialDesign:HintAssist.Hint="Pesquisar por nome, CPF/CNPJ ou e-mail"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                        Text="{Binding Pesquisa, UpdateSourceTrigger=PropertyChanged}" />

                    <Button
                        Grid.Column="2"
                        MinWidth="110"
                        Height="42"
                        Background="{StaticResource LeaziGreenBrush}"
                        Command="{Binding PesquisarCommand}"
                        Content="PESQUISAR"
                        Foreground="White"
                        IsEnabled="{Binding EstaCarregando, Converter={StaticResource InverseBooleanConverter}}"
                        Style="{StaticResource MaterialDesignRaisedButton}" />
                </Grid>

                <DataGrid
                    Grid.Row="2"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    HeadersVisibility="Column"
                    IsReadOnly="True"
                    ItemsSource="{Binding Vendedores}"
                    RowHeaderWidth="0"
                    SelectedItem="{Binding VendedorSelecionado}"
                    SelectionMode="Single">

                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Width="1.7*"
                            Binding="{Binding Nome}"
                            Header="NOME" />

                        <DataGridTextColumn
                            Width="1.25*"
                            Binding="{Binding CpfCnpj}"
                            Header="CPF/CNPJ" />

                        <DataGridTextColumn
                            Width="1.15*"
                            Binding="{Binding Telefone}"
                            Header="TELEFONE" />

                        <DataGridTextColumn
                            Width="1.6*"
                            Binding="{Binding Email}"
                            Header="E-MAIL" />

                        <DataGridTextColumn
                            Width="0.7*"
                            Binding="{Binding PercentualComissao, StringFormat={}{0:N2}%}"
                            Header="COMISSÃO" />

                        <DataGridTemplateColumn
                            Width="0.75*"
                            Header="STATUS">

                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Foreground="{Binding Ativo, Converter={StaticResource BooleanToStatusBrushConverter}}"
                                        Text="{Binding Status}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn
                            Width="1.35*"
                            Header="AÇÕES">

                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button
                                            Margin="0,0,6,0"
                                            Padding="10,5"
                                            Command="{Binding DataContext.EditarCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Content="Editar"
                                            Style="{StaticResource MaterialDesignOutlinedButton}" />

                                        <Button
                                            Padding="10,5"
                                            Command="{Binding DataContext.AlterarStatusCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Content="{Binding Ativo, Converter={StaticResource BooleanToStatusActionConverter}}"
                                            Style="{StaticResource MaterialDesignOutlinedButton}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <DockPanel
                    Grid.Row="3"
                    Margin="0,14,0,0">

                    <ProgressBar
                        Width="120"
                        Height="3"
                        DockPanel.Dock="Right"
                        IsIndeterminate="True"
                        Visibility="{Binding EstaCarregando, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <TextBlock
                        Foreground="#667085"
                        Text="{Binding Vendedores.Count, StringFormat={}Registros encontrados: {0}}" />
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>