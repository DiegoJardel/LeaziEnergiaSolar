<UserControl x:Class="LeaziEnergiaSolar.Wpf.Views.Pages.UsuariosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:utils="clr-namespace:LeaziEnergiaSolar.Wpf.Utils"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="720"
             d:DesignWidth="1180"
             Loaded="UsuariosView_Loaded"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="370" />
            <ColumnDefinition Width="22" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border
            Grid.Column="0"
            Padding="26"
            Background="White"
            CornerRadius="12"
            materialDesign:ElevationAssist.Elevation="Dp2">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <DockPanel>
                        <TextBlock
                            FontSize="21"
                            FontWeight="SemiBold"
                            Text="{Binding TituloFormulario}" />

                        <Button
                            Width="76"
                            Height="34"
                            Command="{Binding NovoCommand}"
                            Content="NOVO"
                            Style="{StaticResource MaterialDesignOutlinedButton}" />
                    </DockPanel>

                    <TextBlock
                        Margin="0,4,0,24"
                        Foreground="#667085"
                        Text="Acesso administrativo ao sistema." />

                    <TextBlock Margin="0,0,0,14" Foreground="#C62828" FontSize="11" Text="Campos marcados com * são obrigatórios." />

                    <TextBox
                        Margin="0,0,0,16"
                        CharacterCasing="Upper"
                        MaxLength="100"
                        materialDesign:HintAssist.Hint="Nome completo"
                        utils:RequiredFieldHelper.IsRequired="True"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                        Text="{Binding Nome, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBox
                        Margin="0,0,0,16"
                        MaxLength="50"
                        materialDesign:HintAssist.Hint="Login"
                        utils:RequiredFieldHelper.IsRequired="True"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                        Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}" />

                    <PasswordBox
                        x:Name="SenhaPasswordBox"
                        Margin="0,0,0,8"
                        materialDesign:HintAssist.Hint="Senha"
                        Style="{StaticResource MaterialDesignOutlinedPasswordBox}" />

                    <TextBlock
                        Margin="0,0,0,16"
                        FontSize="11"
                        Foreground="#667085"
                        Text="No cadastro a senha é obrigatória. Na edição, deixe vazia para manter a senha atual."
                        TextWrapping="Wrap" />

                    <ComboBox
                        Margin="0,0,0,16"
                        ItemsSource="{Binding PerfisDisponiveis}"
                        materialDesign:HintAssist.Hint="Perfil"
                        utils:RequiredFieldHelper.IsRequired="True"
                        SelectedItem="{Binding PerfilSelecionado}"
                        Style="{StaticResource MaterialDesignOutlinedComboBox}" />

                    <ToggleButton
                        Margin="0,0,0,18"
                        Content="Usuário ativo"
                        IsChecked="{Binding Ativo}"
                        Style="{StaticResource MaterialDesignSwitchToggleButton}" />

                    <TextBlock
                        Margin="0,0,0,14"
                        Foreground="{Binding MensagemEhErro, Converter={StaticResource BooleanToMessageBrushConverter}}"
                        Text="{Binding Mensagem}"
                        TextWrapping="Wrap" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button
                            Grid.Column="0"
                            Height="42"
                            Background="{StaticResource LeaziGreenBrush}"
                            Click="Salvar_Click"
                            Content="SALVAR"
                            Foreground="White"
                            IsEnabled="{Binding EstaCarregando, Converter={StaticResource InverseBooleanConverter}}"
                            Style="{StaticResource MaterialDesignRaisedButton}" />

                        <Button
                            Grid.Column="2"
                            Height="42"
                            Command="{Binding LimparCommand}"
                            Content="LIMPAR"
                            Style="{StaticResource MaterialDesignOutlinedButton}" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border
            Grid.Column="2"
            Padding="24"
            Background="White"
            CornerRadius="12"
            materialDesign:ElevationAssist.Elevation="Dp2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox
                        Grid.Column="0"
                        materialDesign:HintAssist.Hint="Pesquisar por nome ou login"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                        Text="{Binding Pesquisa, UpdateSourceTrigger=PropertyChanged}" />

                    <Button
                        Grid.Column="2"
                        Width="110"
                        Height="42"
                        Background="{StaticResource LeaziGreenBrush}"
                        Command="{Binding PesquisarCommand}"
                        Content="PESQUISAR"
                        Foreground="White"
                        Style="{StaticResource MaterialDesignRaisedButton}" />
                </Grid>

                <DataGrid
                    Grid.Row="2"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    HeadersVisibility="Column"
                    IsReadOnly="True"
                    ItemsSource="{Binding Usuarios}"
                    RowHeaderWidth="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Width="1.7*"
                            Binding="{Binding Nome}"
                            Header="NOME" />

                        <DataGridTextColumn
                            Width="1.1*"
                            Binding="{Binding Login}"
                            Header="LOGIN" />

                        <DataGridTextColumn
                            Width="1.1*"
                            Binding="{Binding PerfilDescricao}"
                            Header="PERFIL" />

                        <DataGridTemplateColumn
                            Width="0.8*"
                            Header="STATUS">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Foreground="{Binding Ativo, Converter={StaticResource BooleanToStatusBrushConverter}}"
                                        Text="{Binding Status}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn
                            Width="2.25*"
                            Header="AÇÕES">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button
                                            Margin="0,0,5,0"
                                            Padding="8,4"
                                            Command="{Binding DataContext.EditarCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Content="Editar"
                                            Style="{StaticResource MaterialDesignOutlinedButton}" />

                                        <Button
                                            Margin="0,0,5,0"
                                            Padding="8,4"
                                            Click="RedefinirSenha_Click"
                                            Content="Senha"
                                            Style="{StaticResource MaterialDesignOutlinedButton}" />

                                        <Button
                                            Margin="0,0,5,0"
                                            Padding="8,4"
                                            Command="{Binding DataContext.AlterarStatusCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Content="{Binding Ativo, Converter={StaticResource BooleanToStatusActionConverter}}"
                                            Style="{StaticResource MaterialDesignOutlinedButton}" />

                                        <Button
                                            Padding="8,4"
                                            Click="Excluir_Click"
                                            Content="Excluir"
                                            Foreground="#D92D20"
                                            Style="{StaticResource MaterialDesignOutlinedButton}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <DockPanel
                    Grid.Row="3"
                    Margin="0,12,0,0">
                    <ProgressBar
                        Width="120"
                        Height="3"
                        DockPanel.Dock="Right"
                        IsIndeterminate="True"
                        Visibility="{Binding EstaCarregando, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <TextBlock
                        Foreground="#667085"
                        Text="{Binding Usuarios.Count, StringFormat={}Usuários encontrados: {0}}" />
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>