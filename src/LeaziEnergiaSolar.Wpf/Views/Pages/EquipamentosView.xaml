<UserControl x:Class="LeaziEnergiaSolar.Wpf.Views.Pages.EquipamentosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:utils="clr-namespace:LeaziEnergiaSolar.Wpf.Utils"
             Loaded="EquipamentosView_Loaded">

    <Grid>
        <TabControl>

            <!-- EQUIPAMENTOS -->
            <TabItem Header="EQUIPAMENTOS">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- FORMULÁRIO -->
                    <Border
                        Grid.Column="0"
                        Padding="24"
                        Background="White"
                        CornerRadius="12"
                        materialDesign:ElevationAssist.Elevation="Dp2">

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock
                                    FontSize="21"
                                    FontWeight="SemiBold"
                                    Text="{Binding TituloFormulario}" />

                                <TextBlock
                                    Margin="0,4,0,20"
                                    Foreground="#667085"
                                    Text="Cadastre os dados básicos do equipamento." />

                                <TextBlock
                                    Margin="0,0,0,14"
                                    FontSize="11"
                                    Foreground="#C62828"
                                    Text="Campos marcados com asterisco são obrigatórios." />

                                <TextBox
                                    Margin="0,0,0,12"
                                    CharacterCasing="Upper"
                                    MaxLength="150"
                                    materialDesign:HintAssist.Hint="Descrição"
                                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                    Text="{Binding Descricao,
                                                   UpdateSourceTrigger=PropertyChanged}"
                                    utils:RequiredFieldHelper.IsRequired="True" />

                                <ComboBox
                                    Margin="0,0,0,12"
                                    DisplayMemberPath="Descricao"
                                    ItemsSource="{Binding CategoriasDisponiveis}"
                                    materialDesign:HintAssist.Hint="Categoria"
                                    SelectedItem="{Binding CategoriaSelecionada}"
                                    Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                    utils:RequiredFieldHelper.IsRequired="True" />

                                <ComboBox
                                    Margin="0,0,0,12"
                                    DisplayMemberPath="Nome"
                                    ItemsSource="{Binding MarcasDisponiveis}"
                                    materialDesign:HintAssist.Hint="Marca"
                                    SelectedItem="{Binding MarcaSelecionada}"
                                    Style="{StaticResource MaterialDesignOutlinedComboBox}" />

                                <TextBox
                                    Margin="0,0,0,12"
                                    CharacterCasing="Upper"
                                    MaxLength="100"
                                    materialDesign:HintAssist.Hint="Modelo"
                                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                    Text="{Binding Modelo,
                                                   UpdateSourceTrigger=PropertyChanged}" />

                                <ComboBox
                                    Margin="0,0,0,12"
                                    DisplayMemberPath="Sigla"
                                    ItemsSource="{Binding UnidadesDisponiveis}"
                                    materialDesign:HintAssist.Hint="Unidade de medida"
                                    SelectedItem="{Binding UnidadeSelecionada}"
                                    Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                    utils:RequiredFieldHelper.IsRequired="True" />

                                <TextBox
                                    Height="75"
                                    Margin="0,0,0,14"
                                    AcceptsReturn="True"
                                    CharacterCasing="Upper"
                                    MaxLength="1000"
                                    materialDesign:HintAssist.Hint="Observação"
                                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                    Text="{Binding Observacao,
                                                   UpdateSourceTrigger=PropertyChanged}"
                                    TextWrapping="Wrap" />

                                <ToggleButton
                                    Margin="0,0,0,14"
                                    Content="Equipamento ativo"
                                    IsChecked="{Binding Ativo}"
                                    Style="{StaticResource MaterialDesignSwitchToggleButton}" />

                                <TextBlock
                                    Margin="0,0,0,12"
                                    Foreground="{Binding MensagemEhErro,
                                                         Converter={StaticResource BooleanToMessageBrushConverter}}"
                                    Text="{Binding Mensagem}"
                                    TextWrapping="Wrap" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Button
                                        Grid.Column="0"
                                        Height="42"
                                        Background="{StaticResource LeaziGreenBrush}"
                                        Command="{Binding SalvarCommand}"
                                        Content="SALVAR"
                                        Foreground="White"
                                        IsEnabled="{Binding EstaCarregando,
                                                            Converter={StaticResource InverseBooleanConverter}}"
                                        Style="{StaticResource MaterialDesignRaisedButton}" />

                                    <Button
                                        Grid.Column="2"
                                        Height="42"
                                        Command="{Binding LimparCommand}"
                                        Content="LIMPAR"
                                        IsEnabled="{Binding EstaCarregando,
                                                            Converter={StaticResource InverseBooleanConverter}}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}" />
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- LISTAGEM -->
                    <Border
                        Grid.Column="2"
                        Padding="22"
                        Background="White"
                        CornerRadius="12"
                        materialDesign:ElevationAssist.Elevation="Dp2">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- FILTROS -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="145" />
                                    <ColumnDefinition Width="145" />
                                    <ColumnDefinition Width="115" />
                                    <ColumnDefinition Width="105" />
                                </Grid.ColumnDefinitions>

                                <TextBox
                                    Grid.Column="0"
                                    Margin="0,0,8,0"
                                    materialDesign:HintAssist.Hint="Pesquisar"
                                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                    Text="{Binding Pesquisa,
                                                   UpdateSourceTrigger=PropertyChanged}" />

                                <ComboBox
                                    Grid.Column="1"
                                    Margin="0,0,8,0"
                                    DisplayMemberPath="Descricao"
                                    ItemsSource="{Binding Categorias}"
                                    materialDesign:HintAssist.Hint="Categoria"
                                    SelectedItem="{Binding FiltroCategoria}"
                                    Style="{StaticResource MaterialDesignOutlinedComboBox}" />

                                <ComboBox
                                    Grid.Column="2"
                                    Margin="0,0,8,0"
                                    DisplayMemberPath="Nome"
                                    ItemsSource="{Binding Marcas}"
                                    materialDesign:HintAssist.Hint="Marca"
                                    SelectedItem="{Binding FiltroMarca}"
                                    Style="{StaticResource MaterialDesignOutlinedComboBox}" />

                                <ComboBox
                                    Grid.Column="3"
                                    Margin="0,0,8,0"
                                    ItemsSource="{Binding FiltrosStatus}"
                                    materialDesign:HintAssist.Hint="Status"
                                    SelectedItem="{Binding FiltroStatus}"
                                    Style="{StaticResource MaterialDesignOutlinedComboBox}" />

                                <Button
                                    Grid.Column="4"
                                    Height="42"
                                    Background="{StaticResource LeaziGreenBrush}"
                                    Command="{Binding PesquisarCommand}"
                                    Content="BUSCAR"
                                    Foreground="White"
                                    Style="{StaticResource MaterialDesignRaisedButton}" />
                            </Grid>

                            <DataGrid
                                Grid.Row="2"
                                AutoGenerateColumns="False"
                                CanUserAddRows="False"
                                IsReadOnly="True"
                                ItemsSource="{Binding Equipamentos}"
                                RowHeaderWidth="0">

                                <DataGrid.Columns>
                                    <DataGridTextColumn
                                        Width="65"
                                        Binding="{Binding Codigo}"
                                        Header="CÓD." />

                                    <DataGridTextColumn
                                        Width="1.6*"
                                        Binding="{Binding Descricao}"
                                        Header="DESCRIÇÃO" />

                                    <DataGridTextColumn
                                        Width="1.1*"
                                        Binding="{Binding Categoria}"
                                        Header="CATEGORIA" />

                                    <DataGridTextColumn
                                        Width="1*"
                                        Binding="{Binding Marca}"
                                        Header="MARCA" />

                                    <DataGridTextColumn
                                        Width="1*"
                                        Binding="{Binding Modelo}"
                                        Header="MODELO" />

                                    <DataGridTextColumn
                                        Width="65"
                                        Binding="{Binding UnidadeMedida}"
                                        Header="UN." />

                                    <DataGridTemplateColumn
                                        Width="75"
                                        Header="STATUS">

                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock
                                                    FontWeight="SemiBold"
                                                    Foreground="{Binding Ativo,
                                                                         Converter={StaticResource BooleanToStatusBrushConverter}}"
                                                    Text="{Binding Status}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn
                                        Width="155"
                                        Header="AÇÕES">

                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button
                                                        Margin="0,0,6,0"
                                                        Padding="8,4"
                                                        Command="{Binding DataContext.EditarCommand,
                                                                          RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        Content="Editar"
                                                        Style="{StaticResource MaterialDesignOutlinedButton}" />

                                                    <Button
                                                        Padding="8,4"
                                                        Command="{Binding DataContext.AlterarStatusCommand,
                                                                          RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        Content="{Binding Ativo,
                                                                          Converter={StaticResource BooleanToStatusActionConverter}}"
                                                        Style="{StaticResource MaterialDesignOutlinedButton}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock
                                Grid.Row="3"
                                Margin="0,12,0,0"
                                Foreground="#667085"
                                Text="{Binding Equipamentos.Count,
                                               StringFormat={}Registros encontrados: {0}}" />
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- CATEGORIAS -->
            <TabItem Header="CATEGORIAS">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="330" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.Column="0"
                        Padding="22"
                        Background="White"
                        CornerRadius="12"
                        materialDesign:ElevationAssist.Elevation="Dp2">

                        <StackPanel>
                            <TextBlock
                                FontSize="20"
                                FontWeight="SemiBold"
                                Text="{Binding TituloCategoria}" />

                            <TextBlock
                                Margin="0,4,0,20"
                                Foreground="#667085"
                                Text="Cadastro auxiliar de categorias." />

                            <TextBox
                                Margin="0,0,0,12"
                                CharacterCasing="Upper"
                                MaxLength="100"
                                materialDesign:HintAssist.Hint="Descrição"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                Text="{Binding CategoriaDescricao,
                                               UpdateSourceTrigger=PropertyChanged}"
                                utils:RequiredFieldHelper.IsRequired="True" />

                            <TextBox
                                Height="70"
                                Margin="0,0,0,12"
                                AcceptsReturn="True"
                                CharacterCasing="Upper"
                                MaxLength="500"
                                materialDesign:HintAssist.Hint="Observação"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                Text="{Binding CategoriaObservacao,
                                               UpdateSourceTrigger=PropertyChanged}"
                                TextWrapping="Wrap" />

                            <ToggleButton
                                Margin="0,0,0,14"
                                Content="Categoria ativa"
                                IsChecked="{Binding CategoriaAtivo}"
                                Style="{StaticResource MaterialDesignSwitchToggleButton}" />

                            <Button
                                Height="42"
                                Background="{StaticResource LeaziGreenBrush}"
                                Command="{Binding SalvarCategoriaCommand}"
                                Content="SALVAR"
                                Foreground="White"
                                IsEnabled="{Binding EstaCarregando,
                                                    Converter={StaticResource InverseBooleanConverter}}"
                                Style="{StaticResource MaterialDesignRaisedButton}" />

                            <Button
                                Height="42"
                                Margin="0,10,0,0"
                                Command="{Binding LimparCategoriaCommand}"
                                Content="LIMPAR"
                                IsEnabled="{Binding EstaCarregando,
                                                    Converter={StaticResource InverseBooleanConverter}}"
                                Style="{StaticResource MaterialDesignOutlinedButton}" />
                        </StackPanel>
                    </Border>

                    <Border
                        Grid.Column="2"
                        Padding="22"
                        Background="White"
                        CornerRadius="12"
                        materialDesign:ElevationAssist.Elevation="Dp2">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="140" />
                                </Grid.ColumnDefinitions>

                                <TextBox
                                    Grid.Column="0"
                                    Margin="0,0,10,0"
                                    materialDesign:HintAssist.Hint="Pesquisar categoria"
                                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                    Text="{Binding PesquisaCategoria,
                                                   UpdateSourceTrigger=PropertyChanged}" />

                                <ComboBox
                                    Grid.Column="1"
                                    ItemsSource="{Binding FiltrosStatus}"
                                    materialDesign:HintAssist.Hint="Status"
                                    SelectedItem="{Binding FiltroStatusCategoria}"
                                    Style="{StaticResource MaterialDesignOutlinedComboBox}" />
                            </Grid>

                            <DataGrid
                                Grid.Row="2"
                                AutoGenerateColumns="False"
                                CanUserAddRows="False"
                                IsReadOnly="True"
                                ItemsSource="{Binding Categorias}"
                                RowHeaderWidth="0">

                                <DataGrid.Columns>
                                    <DataGridTextColumn
                                        Width="*"
                                        Binding="{Binding Descricao}"
                                        Header="DESCRIÇÃO" />

                                    <DataGridTextColumn
                                        Width="120"
                                        Binding="{Binding Status}"
                                        Header="STATUS" />

                                    <DataGridTemplateColumn
                                        Width="180"
                                        Header="AÇÕES">

                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button
                                                        Margin="0,0,6,0"
                                                        Padding="8,4"
                                                        Command="{Binding DataContext.EditarCategoriaCommand,
                                                                          RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        Content="Editar"
                                                        Style="{StaticResource MaterialDesignOutlinedButton}" />

                                                    <Button
                                                        Padding="8,4"
                                                        Command="{Binding DataContext.AlterarStatusCategoriaCommand,
                                                                          RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        Content="{Binding Ativo,
                                                                          Converter={StaticResource BooleanToStatusActionConverter}}"
                                                        Style="{StaticResource MaterialDesignOutlinedButton}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- MARCAS -->
            <TabItem Header="MARCAS">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="330" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.Column="0"
                        Padding="22"
                        Background="White"
                        CornerRadius="12"
                        materialDesign:ElevationAssist.Elevation="Dp2">

                        <StackPanel>
                            <TextBlock
                                FontSize="20"
                                FontWeight="SemiBold"
                                Text="{Binding TituloMarca}" />

                            <TextBlock
                                Margin="0,4,0,20"
                                Foreground="#667085"
                                Text="Cadastro auxiliar de marcas." />

                            <TextBox
                                Margin="0,0,0,12"
                                CharacterCasing="Upper"
                                MaxLength="100"
                                materialDesign:HintAssist.Hint="Nome"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                Text="{Binding MarcaNome,
                                               UpdateSourceTrigger=PropertyChanged}"
                                utils:RequiredFieldHelper.IsRequired="True" />

                            <TextBox
                                Height="70"
                                Margin="0,0,0,12"
                                AcceptsReturn="True"
                                CharacterCasing="Upper"
                                MaxLength="500"
                                materialDesign:HintAssist.Hint="Observação"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                Text="{Binding MarcaObservacao,
                                               UpdateSourceTrigger=PropertyChanged}"
                                TextWrapping="Wrap" />

                            <ToggleButton
                                Margin="0,0,0,14"
                                Content="Marca ativa"
                                IsChecked="{Binding MarcaAtivo}"
                                Style="{StaticResource MaterialDesignSwitchToggleButton}" />

                            <Button
                                Height="42"
                                Background="{StaticResource LeaziGreenBrush}"
                                Command="{Binding SalvarMarcaCommand}"
                                Content="SALVAR"
                                Foreground="White"
                                IsEnabled="{Binding EstaCarregando,
                                                    Converter={StaticResource InverseBooleanConverter}}"
                                Style="{StaticResource MaterialDesignRaisedButton}" />

                            <Button
                                Height="42"
                                Margin="0,10,0,0"
                                Command="{Binding LimparMarcaCommand}"
                                Content="LIMPAR"
                                IsEnabled="{Binding EstaCarregando,
                                                    Converter={StaticResource InverseBooleanConverter}}"
                                Style="{StaticResource MaterialDesignOutlinedButton}" />
                        </StackPanel>
                    </Border>

                    <Border
                        Grid.Column="2"
                        Padding="22"
                        Background="White"
                        CornerRadius="12"
                        materialDesign:ElevationAssist.Elevation="Dp2">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="140" />
                                </Grid.ColumnDefinitions>

                                <TextBox
                                    Grid.Column="0"
                                    Margin="0,0,10,0"
                                    materialDesign:HintAssist.Hint="Pesquisar marca"
                                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                    Text="{Binding PesquisaMarca,
                                                   UpdateSourceTrigger=PropertyChanged}" />

                                <ComboBox
                                    Grid.Column="1"
                                    ItemsSource="{Binding FiltrosStatus}"
                                    materialDesign:HintAssist.Hint="Status"
                                    SelectedItem="{Binding FiltroStatusMarca}"
                                    Style="{StaticResource MaterialDesignOutlinedComboBox}" />
                            </Grid>

                            <DataGrid
                                Grid.Row="2"
                                AutoGenerateColumns="False"
                                CanUserAddRows="False"
                                IsReadOnly="True"
                                ItemsSource="{Binding Marcas}"
                                RowHeaderWidth="0">

                                <DataGrid.Columns>
                                    <DataGridTextColumn
                                        Width="*"
                                        Binding="{Binding Nome}"
                                        Header="NOME" />

                                    <DataGridTextColumn
                                        Width="120"
                                        Binding="{Binding Status}"
                                        Header="STATUS" />

                                    <DataGridTemplateColumn
                                        Width="180"
                                        Header="AÇÕES">

                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button
                                                        Margin="0,0,6,0"
                                                        Padding="8,4"
                                                        Command="{Binding DataContext.EditarMarcaCommand,
                                                                          RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        Content="Editar"
                                                        Style="{StaticResource MaterialDesignOutlinedButton}" />

                                                    <Button
                                                        Padding="8,4"
                                                        Command="{Binding DataContext.AlterarStatusMarcaCommand,
                                                                          RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        Content="{Binding Ativo,
                                                                          Converter={StaticResource BooleanToStatusActionConverter}}"
                                                        Style="{StaticResource MaterialDesignOutlinedButton}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- UNIDADES -->
            <TabItem Header="UNIDADES">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="330" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.Column="0"
                        Padding="22"
                        Background="White"
                        CornerRadius="12"
                        materialDesign:ElevationAssist.Elevation="Dp2">

                        <StackPanel>
                            <TextBlock
                                FontSize="20"
                                FontWeight="SemiBold"
                                Text="{Binding TituloUnidade}" />

                            <TextBlock
                                Margin="0,4,0,20"
                                Foreground="#667085"
                                Text="Cadastro auxiliar de unidades de medida." />

                            <TextBox
                                Margin="0,0,0,12"
                                CharacterCasing="Upper"
                                MaxLength="10"
                                materialDesign:HintAssist.Hint="Sigla"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                Text="{Binding UnidadeSigla,
                                               UpdateSourceTrigger=PropertyChanged}"
                                utils:RequiredFieldHelper.IsRequired="True" />

                            <TextBox
                                Margin="0,0,0,12"
                                CharacterCasing="Upper"
                                MaxLength="100"
                                materialDesign:HintAssist.Hint="Descrição"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                Text="{Binding UnidadeDescricao,
                                               UpdateSourceTrigger=PropertyChanged}"
                                utils:RequiredFieldHelper.IsRequired="True" />

                            <CheckBox
                                Margin="0,0,0,14"
                                Content="Permite quantidade decimal"
                                IsChecked="{Binding UnidadePermiteQuantidadeDecimal}" />

                            <ToggleButton
                                Margin="0,0,0,14"
                                Content="Unidade ativa"
                                IsChecked="{Binding UnidadeAtivo}"
                                Style="{StaticResource MaterialDesignSwitchToggleButton}" />

                            <Button
                                Height="42"
                                Background="{StaticResource LeaziGreenBrush}"
                                Command="{Binding SalvarUnidadeCommand}"
                                Content="SALVAR"
                                Foreground="White"
                                IsEnabled="{Binding EstaCarregando,
                                                    Converter={StaticResource InverseBooleanConverter}}"
                                Style="{StaticResource MaterialDesignRaisedButton}" />

                            <Button
                                Height="42"
                                Margin="0,10,0,0"
                                Command="{Binding LimparUnidadeCommand}"
                                Content="LIMPAR"
                                IsEnabled="{Binding EstaCarregando,
                                                    Converter={StaticResource InverseBooleanConverter}}"
                                Style="{StaticResource MaterialDesignOutlinedButton}" />
                        </StackPanel>
                    </Border>

                    <Border
                        Grid.Column="2"
                        Padding="22"
                        Background="White"
                        CornerRadius="12"
                        materialDesign:ElevationAssist.Elevation="Dp2">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="140" />
                                </Grid.ColumnDefinitions>

                                <TextBox
                                    Grid.Column="0"
                                    Margin="0,0,10,0"
                                    materialDesign:HintAssist.Hint="Pesquisar unidade"
                                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                    Text="{Binding PesquisaUnidade,
                                                   UpdateSourceTrigger=PropertyChanged}" />

                                <ComboBox
                                    Grid.Column="1"
                                    ItemsSource="{Binding FiltrosStatus}"
                                    materialDesign:HintAssist.Hint="Status"
                                    SelectedItem="{Binding FiltroStatusUnidade}"
                                    Style="{StaticResource MaterialDesignOutlinedComboBox}" />
                            </Grid>

                            <DataGrid
                                Grid.Row="2"
                                AutoGenerateColumns="False"
                                CanUserAddRows="False"
                                IsReadOnly="True"
                                ItemsSource="{Binding Unidades}"
                                RowHeaderWidth="0">

                                <DataGrid.Columns>
                                    <DataGridTextColumn
                                        Width="90"
                                        Binding="{Binding Sigla}"
                                        Header="SIGLA" />

                                    <DataGridTextColumn
                                        Width="*"
                                        Binding="{Binding Descricao}"
                                        Header="DESCRIÇÃO" />

                                    <DataGridCheckBoxColumn
                                        Width="110"
                                        Binding="{Binding PermiteQuantidadeDecimal}"
                                        Header="DECIMAL" />

                                    <DataGridTextColumn
                                        Width="100"
                                        Binding="{Binding Status}"
                                        Header="STATUS" />

                                    <DataGridTemplateColumn
                                        Width="180"
                                        Header="AÇÕES">

                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button
                                                        Margin="0,0,6,0"
                                                        Padding="8,4"
                                                        Command="{Binding DataContext.EditarUnidadeCommand,
                                                                          RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        Content="Editar"
                                                        Style="{StaticResource MaterialDesignOutlinedButton}" />

                                                    <Button
                                                        Padding="8,4"
                                                        Command="{Binding DataContext.AlterarStatusUnidadeCommand,
                                                                          RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        Content="{Binding Ativo,
                                                                          Converter={StaticResource BooleanToStatusActionConverter}}"
                                                        Style="{StaticResource MaterialDesignOutlinedButton}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>