<Window x:Class="LeaziEnergiaSolar.Wpf.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Leazi Energia Solar"
        Width="1100"
        Height="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBackgroundBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.15*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="{StaticResource LeaziGreenBrush}">
            <StackPanel
                Margin="75"
                VerticalAlignment="Center">
                <Image
                    Width="300"
                    Source="/Assets/Images/logo-leazi.png" />

                <TextBlock
                    Margin="0,28,0,8"
                    HorizontalAlignment="Center"
                    FontSize="25"
                    FontWeight="SemiBold"
                    Foreground="White"
                    Text="Controle de Vendas e Comissões" />

                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="16"
                    Foreground="#DFFFF0"
                    Text="Gestão simples para a equipe Leazi" />
            </StackPanel>
        </Border>

        <Border
            Grid.Column="1"
            Width="380"
            Padding="42"
            VerticalAlignment="Center"
            Background="White"
            CornerRadius="12"
            materialDesign:ElevationAssist.Elevation="Dp4">
            <StackPanel>
                <TextBlock
                    FontSize="28"
                    FontWeight="SemiBold"
                    Text="Acessar sistema" />

                <TextBlock
                    Margin="0,4,0,30"
                    Foreground="#667085"
                    Text="Informe seus dados para continuar" />

                <TextBox
                    Margin="0,0,0,18"
                    materialDesign:HintAssist.Hint="Usuário"
                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                    Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}" />

                <PasswordBox
                    x:Name="SenhaPasswordBox"
                    Margin="0,0,0,12"
                    materialDesign:HintAssist.Hint="Senha"
                    KeyDown="SenhaPasswordBox_KeyDown"
                    Style="{StaticResource MaterialDesignOutlinedPasswordBox}" />

                <TextBlock
                    Margin="0,0,0,14"
                    Foreground="#D92D20"
                    Text="{Binding MensagemErro}"
                    TextWrapping="Wrap" />

                <Button
                    Height="46"
                    Background="{StaticResource LeaziGreenBrush}"
                    Click="Entrar_Click"
                    Content="ENTRAR"
                    Foreground="White"
                    IsEnabled="{Binding EstaCarregando, Converter={StaticResource InverseBooleanConverter}}"
                    Style="{StaticResource MaterialDesignRaisedButton}" />

                <ProgressBar
                    Height="3"
                    Margin="0,12,0,0"
                    IsIndeterminate="True"
                    Visibility="{Binding EstaCarregando, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <TextBlock
                    Margin="0,18,0,0"
                    HorizontalAlignment="Center"
                    Foreground="#98A2B3"
                    Text="Acesso inicial de desenvolvimento: admin / admin" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
