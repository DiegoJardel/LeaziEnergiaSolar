<UserControl x:Class="LeaziEnergiaSolar.Wpf.Views.Pages.RelatoriosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:utils="clr-namespace:LeaziEnergiaSolar.Wpf.Utils"
             d:DesignHeight="740"
             d:DesignWidth="1180"
             Loaded="RelatoriosView_Loaded"
             mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Padding="22"
            Background="White"
            CornerRadius="12"
            materialDesign:ElevationAssist.Elevation="Dp2">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock
                        FontSize="21"
                        FontWeight="SemiBold"
                        Text="Relatórios de vendas e comissões" />

                    <TextBlock
                        Margin="0,4,0,0"
                        Foreground="#667085"
                        Text="Selecione o tipo de relatório, informe os filtros e gere o arquivo em PDF." />
                </StackPanel>

                <materialDesign:PackIcon
                    Grid.Column="1"
                    Width="38"
                    Height="38"
                    VerticalAlignment="Center"
                    Foreground="{StaticResource LeaziGreenBrush}"
                    Kind="FilePdfBox" />
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="440" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Padding="24"
                Background="White"
                CornerRadius="12"
                materialDesign:ElevationAssist.Elevation="Dp2">

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock
                            FontSize="18"
                            FontWeight="SemiBold"
                            Text="Configuração do relatório" />

                        <TextBlock
                            Margin="0,4,0,20"
                            Foreground="#667085"
                            Text="Os campos disponíveis mudam conforme o tipo de relatório selecionado."
                            TextWrapping="Wrap" />

                        <TextBlock
                            Margin="0,0,0,14"
                            FontSize="11"
                            Foreground="#C62828"
                            Text="Campos marcados com asterisco são obrigatórios." />

                        <ComboBox
                            Margin="0,0,0,16"
                            DisplayMemberPath="Descricao"
                            ItemsSource="{Binding TiposRelatorio}"
                            materialDesign:HintAssist.Hint="Tipo de relatório"
                            SelectedItem="{Binding TipoRelatorioSelecionado, Mode=TwoWay}"
                            Style="{StaticResource MaterialDesignOutlinedComboBox}"
                            utils:RequiredFieldHelper.IsRequired="True" />

                        <TextBlock
                            Margin="0,2,0,10"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="#344054"
                            Text="Período da venda" />

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <DatePicker
                                Grid.Column="0"
                                materialDesign:HintAssist.Hint="Data inicial"
                                SelectedDate="{Binding DataVendaInicial, Mode=TwoWay}"
                                Style="{StaticResource MaterialDesignOutlinedDatePicker}" />

                            <DatePicker
                                Grid.Column="2"
                                materialDesign:HintAssist.Hint="Data final"
                                SelectedDate="{Binding DataVendaFinal, Mode=TwoWay}"
                                Style="{StaticResource MaterialDesignOutlinedDatePicker}" />
                        </Grid>

                        <TextBlock
                            Margin="0,2,0,10"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="#344054"
                            Text="Período do pagamento" />

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <DatePicker
                                Grid.Column="0"
                                IsEnabled="{Binding PodeFiltrarDataPagamento}"
                                materialDesign:HintAssist.Hint="Pagamento inicial"
                                SelectedDate="{Binding DataPagamentoInicial, Mode=TwoWay}"
                                Style="{StaticResource MaterialDesignOutlinedDatePicker}" />

                            <DatePicker
                                Grid.Column="2"
                                IsEnabled="{Binding PodeFiltrarDataPagamento}"
                                materialDesign:HintAssist.Hint="Pagamento final"
                                SelectedDate="{Binding DataPagamentoFinal, Mode=TwoWay}"
                                Style="{StaticResource MaterialDesignOutlinedDatePicker}" />
                        </Grid>

                        <ComboBox
                            Margin="0,0,0,16"
                            DisplayMemberPath="Nome"
                            ItemsSource="{Binding Vendedores}"
                            materialDesign:HintAssist.Hint="Vendedor"
                            SelectedItem="{Binding VendedorSelecionado, Mode=TwoWay}"
                            Style="{StaticResource MaterialDesignOutlinedComboBox}" />

                        <ComboBox
                            Margin="0,0,0,16"
                            DisplayMemberPath="NomeRazaoSocial"
                            ItemsSource="{Binding Clientes}"
                            materialDesign:HintAssist.Hint="Cliente"
                            SelectedItem="{Binding ClienteSelecionado, Mode=TwoWay}"
                            Style="{StaticResource MaterialDesignOutlinedComboBox}" />

                        <ComboBox
                            Margin="0,0,0,16"
                            IsEnabled="{Binding PodeSelecionarStatus}"
                            ItemsSource="{Binding StatusDisponiveis}"
                            materialDesign:HintAssist.Hint="Status"
                            SelectedItem="{Binding StatusSelecionado, Mode=TwoWay}"
                            Style="{StaticResource MaterialDesignOutlinedComboBox}" />

                        <TextBox
                            Margin="0,0,0,18"
                            MaxLength="150"
                            materialDesign:HintAssist.Hint="Cliente, vendedor ou documento"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                            Text="{Binding Pesquisa, UpdateSourceTrigger=PropertyChanged}" />

                        <Border
                            Margin="0,0,0,16"
                            Padding="12"
                            Background="#EAF4EC"
                            BorderBrush="#B7D9BE"
                            BorderThickness="1"
                            CornerRadius="8">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <materialDesign:PackIcon
                                    Grid.Column="0"
                                    Width="22"
                                    Height="22"
                                    VerticalAlignment="Top"
                                    Foreground="{StaticResource LeaziGreenBrush}"
                                    Kind="InformationOutline" />

                                <TextBlock
                                    Grid.Column="2"
                                    Foreground="#344054"
                                    Text="{Binding DescricaoTipoRelatorio}"
                                    TextWrapping="Wrap" />
                            </Grid>
                        </Border>

                        <TextBlock
                            Margin="0,0,0,14"
                            Foreground="{Binding MensagemEhErro, Converter={StaticResource BooleanToMessageBrushConverter}}"
                            Text="{Binding Mensagem}"
                            TextWrapping="Wrap" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="1.25*" />
                            </Grid.ColumnDefinitions>

                            <Button
                                Grid.Column="0"
                                Height="42"
                                Command="{Binding LimparCommand}"
                                Content="LIMPAR"
                                IsEnabled="{Binding EstaCarregando, Converter={StaticResource InverseBooleanConverter}}"
                                Style="{StaticResource MaterialDesignOutlinedButton}" />

                            <Button
                                Grid.Column="2"
                                Height="42"
                                Background="{StaticResource LeaziGreenBrush}"
                                Command="{Binding GerarPdfCommand}"
                                Foreground="White"
                                IsEnabled="{Binding EstaCarregando, Converter={StaticResource InverseBooleanConverter}}"
                                Style="{StaticResource MaterialDesignRaisedButton}">

                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        Width="19"
                                        Height="19"
                                        Margin="0,0,8,0"
                                        Kind="FilePdfBox" />

                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontWeight="SemiBold"
                                        Text="GERAR PDF" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <ProgressBar
                            Height="3"
                            Margin="0,14,0,0"
                            IsIndeterminate="True"
                            Visibility="{Binding EstaCarregando, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border
                Grid.Column="2"
                Padding="24"
                Background="White"
                CornerRadius="12"
                materialDesign:ElevationAssist.Elevation="Dp2">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Text="Relatórios disponíveis" />

                    <Border
                        Grid.Row="2"
                        Padding="16"
                        Background="#F5F7F6"
                        BorderBrush="#D0D5DD"
                        BorderThickness="1"
                        CornerRadius="10">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Grid.Column="0"
                                Width="48"
                                Height="48"
                                Background="#EAF4EC"
                                CornerRadius="24">

                                <materialDesign:PackIcon
                                    Width="26"
                                    Height="26"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="{StaticResource LeaziGreenBrush}"
                                    Kind="FileChartOutline" />
                            </Border>

                            <StackPanel Grid.Column="2">
                                <TextBlock
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    Foreground="#344054"
                                    Text="{Binding NomeTipoRelatorio}" />

                                <TextBlock
                                    Margin="0,5,0,0"
                                    Foreground="#667085"
                                    Text="{Binding DescricaoTipoRelatorio}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ScrollViewer
                        Grid.Row="4"
                        VerticalScrollBarVisibility="Auto">

                        <StackPanel>
                            <Border Margin="0,0,0,12" Padding="16" Background="White" BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="38" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Grid.Column="0" Width="24" Height="24" VerticalAlignment="Top" Foreground="{StaticResource LeaziGreenBrush}" Kind="ChartBoxOutline" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock FontSize="14" FontWeight="SemiBold" Text="Executivo de vendas e comissões" />
                                        <TextBlock Margin="0,4,0,0" Foreground="#667085" Text="Resumo para diretoria com total vendido, comissões pagas, pendentes e indicadores do período." TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Margin="0,0,0,12" Padding="16" Background="White" BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="38" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Grid.Column="0" Width="24" Height="24" VerticalAlignment="Top" Foreground="#C62828" Kind="CashClock" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock FontSize="14" FontWeight="SemiBold" Text="Comissões a pagar" />
                                        <TextBlock Margin="0,4,0,0" Foreground="#667085" Text="Mostra somente as comissões pendentes e quanto a empresa ainda precisa pagar." TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Margin="0,0,0,12" Padding="16" Background="White" BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="38" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Grid.Column="0" Width="24" Height="24" VerticalAlignment="Top" Foreground="{StaticResource LeaziGreenBrush}" Kind="CashCheck" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock FontSize="14" FontWeight="SemiBold" Text="Comissões pagas" />
                                        <TextBlock Margin="0,4,0,0" Foreground="#667085" Text="Apresenta as comissões liquidadas e suas respectivas datas de pagamento." TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Margin="0,0,0,12" Padding="16" Background="White" BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="38" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Grid.Column="0" Width="24" Height="24" VerticalAlignment="Top" Foreground="{StaticResource LeaziGreenBrush}" Kind="AccountCashOutline" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock FontSize="14" FontWeight="SemiBold" Text="Comissões por vendedor" />
                                        <TextBlock Margin="0,4,0,0" Foreground="#667085" Text="Agrupa vendas, pagamentos e pendências de cada vendedor." TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Margin="0,0,0,12" Padding="16" Background="White" BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="38" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Grid.Column="0" Width="24" Height="24" VerticalAlignment="Top" Foreground="{StaticResource LeaziGreenBrush}" Kind="AccountDetailsOutline" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock FontSize="14" FontWeight="SemiBold" Text="Extrato individual do vendedor" />
                                        <TextBlock Margin="0,4,0,0" Foreground="#667085" Text="Gera um demonstrativo individual para o vendedor selecionado." TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Padding="16" Background="White" BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="38" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Grid.Column="0" Width="24" Height="24" VerticalAlignment="Top" Foreground="{StaticResource LeaziGreenBrush}" Kind="FileTableBoxMultipleOutline" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock FontSize="14" FontWeight="SemiBold" Text="Relatório geral de comissões" />
                                        <TextBlock Margin="0,4,0,0" Foreground="#667085" Text="Reúne comissões pagas e pendentes em um único PDF, com totais e detalhamento." TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Border
                        Grid.Row="5"
                        Margin="0,18,0,0"
                        Padding="12"
                        Background="#EAF4EC"
                        BorderBrush="#B7D9BE"
                        BorderThickness="1"
                        CornerRadius="8">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <materialDesign:PackIcon
                                Grid.Column="0"
                                Width="21"
                                Height="21"
                                VerticalAlignment="Top"
                                Foreground="{StaticResource LeaziGreenBrush}"
                                Kind="CheckCircleOutline" />

                            <TextBlock
                                Grid.Column="2"
                                Foreground="#344054"
                                Text="Todos os modelos de relatório estão disponíveis. Selecione o tipo desejado, informe os filtros e clique em GERAR PDF."
                                TextWrapping="Wrap" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
